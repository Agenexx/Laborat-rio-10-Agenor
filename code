import torch
import time
import gc
from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig

device = "cuda" if torch.cuda.is_available() else "cpu"
model_id = "TinyLlama/TinyLlama-1.1B-Chat-v1.0"

print("="*50)
print("LAB INTEGRADOR: OTIMIZAÇÃO DE INFERÊNCIA LLM")
print("="*50)

# PASSO 1: Ingestão Eficiente (QLoRA)

print("\n[Passo 1] Carregando Modelo com Quantização em 4-bits...")
quantization_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_compute_dtype=torch.float16
)

tokenizer = AutoTokenizer.from_pretrained(model_id)
model_baseline = AutoModelForCausalLM.from_pretrained(
    model_id,
    quantization_config=quantization_config,
    device_map="auto"
)
vram_loaded_mb = torch.cuda.memory_allocated() / (1024 ** 2)
print(f"> VRAM ocupada pelo modelo carregado: {vram_loaded_mb:.2f} MB")

# PASSO 2: Simulando o RAG Massivo

print("\n[Passo 2] Simulando Recuperação do RAG...")
# Criamos uma frase médica longa e a multiplicamos para gerar contexto
frase_medica = "O paciente no leito 4 apresenta quadro clinico de sepse, requerendo administracao imediata de antibioticos de amplo espectro e monitoramento hemodinamico. "
texto_rag = frase_medica * 750 # Multiplicador ajustado para gerar ~15.000 tokens no TinyLlama

inputs = tokenizer(texto_rag, return_tensors="pt").to(device)
num_tokens = inputs.input_ids.shape[1]
print(f"> Contexto gerado com sucesso. Total de tokens: {num_tokens}")

# PASSO 3: O Gargalo de Geração (Problema do Decoder)

print("\n[Passo 3] Gerando 100 tokens SEM KV Cache...")
# Limpamos as estatísticas de memória da GPU
torch.cuda.reset_peak_memory_stats()
model_baseline.config.use_cache = False # Desativando Cache

start_time = time.time()
with torch.no_grad():
    _ = model_baseline.generate(**inputs, max_new_tokens=100)
time_no_cache = time.time() - start_time
peak_vram_no_cache = torch.cuda.max_memory_allocated() / (1024 ** 2)

print(f"> Tempo de geração (Sem Cache): {time_no_cache:.2f} segundos")
print(f"> Pico de VRAM durante geração (Sem Cache): {peak_vram_no_cache:.2f} MB")

# Limpando a memória
del model_baseline
gc.collect()
torch.cuda.empty_cache()

# PASSO 4: A Engenharia de Otimização (FlashAttention + KV Cache)

print("\n[Passo 4] Gerando 100 tokens COM KV Cache + FlashAttention-2...")

# Recarregando o modelo com a implementação otimizada de atenção
model_optim = AutoModelForCausalLM.from_pretrained(
    model_id,
    quantization_config=quantization_config,
    device_map="auto",
    attn_implementation="flash_attention_2"
)
model_optim.config.use_cache = True # Ativando KV Cache

torch.cuda.reset_peak_memory_stats()
start_time_opt = time.time()
with torch.no_grad():
    _ = model_optim.generate(**inputs, max_new_tokens=100)
time_cache = time.time() - start_time_opt
peak_vram_cache = torch.cuda.max_memory_allocated() / (1024 ** 2)

print(f"> Tempo de geração (Com Cache + FA2): {time_cache:.2f} segundos")
print(f"> Pico de VRAM durante geração (Com Cache + FA2): {peak_vram_cache:.2f} MB")
print("="*50)
